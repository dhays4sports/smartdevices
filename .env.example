# Local visual/demo mode. Never enable this on a public production deployment.
SMARTDEVICES_DEMO_MODE=false

# Server-side JSON array of current professional grants. Keep absent until an
# approved identity/role owner has configured issuance, expiry, and offboarding.
SMARTDEVICES_PRO_AUTH_JSON=

# Server-side JSON array of evidence-administrator grants. Evidence admins may
# start refreshes, resolve review items, publish snapshots, and roll back.
SMARTDEVICES_EVIDENCE_ADMIN_JSON=

# Long random credential used only by the scheduled refresh endpoint.
SMARTDEVICES_EVIDENCE_SCHEDULER_TOKEN=

# External source retrieval is initiated only by an authorized admin or the
# authenticated scheduler. Keep unset until outbound source review is approved.
SMARTDEVICES_EVIDENCE_REFRESH_ENABLED=false

# External services are intentionally disabled until explicit activation.
COVERAGEFIT_ENDPOINT=
COVERAGEFIT_SIGNING_SECRET=
# Separate, task-scoped CoverageFit closing bridge. No defaults activate it.
COVERAGEFIT_DEVICE_BRIDGE_ENABLED=false
COVERAGEFIT_ORIGIN=
SMARTDEVICES_BRIDGE_SECRET=
FARMERS408_ENDPOINT=
FARMERS408_SIGNING_SECRET=
COMMUNICATION_PROVIDER=
COMMUNICATION_API_KEY=
RATE_LIMIT_HASH_SALT=

# Optional evidence-validation clock override for a controlled release check.
# Omit in normal operation; never use it to make stale evidence appear current.
SD42_REVIEW_DATE=

# Operational values require owner/legal approval before production activation.
CONSENT_POLICY_VERSION=
PLAN_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=

# SmartDevices Builder v5.2 — model-assisted requirements + live web research.
# The model boundary is optional; Builder retains a deterministic requirements path.
SMARTDEVICES_AI_ENABLED=false
SMARTDEVICES_AI_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
SMARTDEVICES_LIVE_RESEARCH_ENABLED=false

# Optional supplier intelligence service. It must accept the documented Builder
# sourcing contract over HTTPS and return source-attributed part/availability data.
SMARTDEVICES_LIVE_SOURCING_ENABLED=false
SMARTDEVICES_SOURCING_ENDPOINT=
SMARTDEVICES_SOURCING_TOKEN=

# Optional sandboxed build service. Do NOT point this at a general-purpose host.
# The executor must compile the firmware and execute CadQuery in an isolated sandbox.
SMARTDEVICES_BUILD_EXECUTOR_ENABLED=false
SMARTDEVICES_BUILD_EXECUTOR_ENDPOINT=
SMARTDEVICES_BUILD_EXECUTOR_TOKEN=
